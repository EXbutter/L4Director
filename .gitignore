# ---------- 依赖 ----------
node_modules/
frontend/node_modules/
.venv/
venv/
env/

# ---------- 便携运行时（约 43MB，不进仓库）----------
# 构建时由 setup_embedded_python.py 生成，用户侧自备 Python 即可
backend/embedded_python/
backend/get-pip.py

# ---------- 构建产物 ----------
frontend/dist/
# 预裁剪的 Electron 发行版（硬链接，随 node_modules 重建）
frontend/.cache/
# 打包输出（electron-builder 的 directories.output）
frontend/out*/
frontend/release/
frontend/release*/
dist/
release/
build/
*.tsbuildinfo
*.asar

# ---------- Python ----------
__pycache__/
*.py[cod]
*.pyd
*.so
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 日志与调试残留 ----------
*.log
logs/
backend_output.log
*_output.log
vpk_debug*.txt
# 旧版 verify 脚本的落盘输出（新版统一打到 stdout）
scripts/_verify_*.txt

# ---------- 备份与临时文件 ----------
*.bak
*.tmp
*.temp
*.orig
*.rej
_archive/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- 本地配置与密钥 ----------
.env
.env.*
!.env.example
*.local
config.local.*
# Steam API Key 只存在用户数据目录（~/.l4d2-manager/config.json），
# 任何形式的密钥文件都不许进仓库
*.key
steam_api_key*
# 调试用的临时目录（网页 dump、一次性探针脚本）
.tmp_preview/
# 解包安装包做验证时的暂存目录（里面的 app.asar 会被宿主进程占住，退出后再清）
frontend/.tmp_extract/

# ---------- 个人收款码 / 二维码 ----------
# frontend/public/ 下的所有文件都会被 vite 原样复制进 dist，再由 electron-builder
# 打进 app.asar —— 放在这里等于随安装包公开发布。个人收款码一律不进 public。
frontend/public/thankyou.png
frontend/public/pay*.png
frontend/public/*qrcode*
frontend/public/*qr-code*

# ---------- 工作区工具目录（含个人上下文，不公开）----------
.workbuddy/

# ---------- 内部规划文档（发展/运营/流程指南，不公开）----------
# 对外发版说明在 docs/（入库）；规划稿只放 docs-internal/
docs-internal/
